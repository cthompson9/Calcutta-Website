{
  "name": "@workspace/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema/index.ts"
  },
  "scripts": {
    "push": "drizzle-kit push --config ./drizzle.config.ts",
    "push-force": "drizzle-kit push --force --config ./drizzle.config.ts",
    "backfill-period-snapshots": "pnpm --filter @workspace/api-server exec tsx ../../lib/db/src/backfillPeriodSnapshots.ts",
    "backfill-owner-positions": "pnpm --filter @workspace/api-server exec tsx ../../lib/db/src/backfillOwnerPositions.ts",
    "load-historical-calcuttas": "pnpm --filter @workspace/api-server exec tsx ../../lib/db/src/scripts/loadHistoricalCalcuttas.ts",
    "audit-owner-identity": "pnpm --filter @workspace/api-server exec tsx ../../lib/db/src/scripts/auditOwnerIdentity.ts",
    "test": "pnpm --filter @workspace/api-server exec node --import tsx/esm --test ../../lib/db/src/**/*.test.mjs ../../lib/db/src/**/*.test.ts"
  },
  "dependencies": {
    "drizzle-orm": "catalog:",
    "drizzle-zod": "^0.8.3",
    "pg": "^8.22.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@types/pg": "^8.20.0",
    "drizzle-kit": "^0.31.10"
  }
}
