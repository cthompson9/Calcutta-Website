{
  "name": "@workspace/api-server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "export NODE_ENV=development && pnpm run build && node --enable-source-maps ./dist/index.mjs",
    "build": "node ./build.mjs",
    "start": "export NODE_ENV=production && node --enable-source-maps ./dist/index.mjs",
    "refresh:nfl-standings": "node --import tsx/esm src/jobs/nflStandingsRefresh.ts",
    "test": "node --import tsx/esm --test --test-concurrency=1 src/**/*.test.mjs",
    "test:historical": "node --import tsx/esm --test src/lib/historicalScoring.test.mjs",
    "reconcile:historical": "node --import tsx/esm src/scripts/reconcileHistoricalCalcuttas.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@workspace/api-zod": "workspace:*",
    "@workspace/db": "workspace:*",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "drizzle-orm": "catalog:",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.2",
    "helmet": "^8.1.0",
    "pino": "^9.14.0",
    "pino-http": "^10.5.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "catalog:",
    "esbuild": "0.27.3",
    "esbuild-plugin-pino": "^2.3.3",
    "pino-pretty": "^13.1.3",
    "thread-stream": "3.1.0",
    "tsx": "catalog:"
  }
}
